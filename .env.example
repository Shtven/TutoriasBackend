# JWT propio del backend (HS256). Minimo 32 caracteres.
API_KEY=your-jwt-signing-secret-min-32-chars
API_JWT_EXPIRATION=36000000

# Base de datos. En Supabase: Project Settings > Database > Connection string
# (JDBC). El esquema se crea con db/supabase/001_esquema.sql.
DB_URL=jdbc:postgresql://localhost:5432/tutorias
DB_USERNAME=postgres
DB_PASSWORD=postgres

# SendGrid (https://sendgrid.com) - API HTTP de correo. Reemplaza al SMTP de
# Gmail porque plataformas como Render bloquean puertos SMTP salientes.
# 1. Crea cuenta en sendgrid.com (free tier: 100 correos/dia)
# 2. Genera una API key en Settings > API Keys (permiso "Mail Send")
# 3. Verifica el remitente en Settings > Sender Authentication (Single Sender
#    Verification para pruebas, Domain Authentication para produccion). El
#    valor de SENDGRID_FROM debe coincidir con un remitente verificado.
SENDGRID_API_KEY=SG.your_api_key
SENDGRID_FROM=noreply@tu-dominio.com

# Origenes del frontend, separados por coma (scheme://host:puerto). Se
# admite comodin en un patron ("https://front-pr-*.onrender.com", para PR
# previews), pero no "*" a secas. Ver docs/README.md, seccion CORS.
#   Produccion: Static Site del front en Render.
#   Local: 4173 = "npm run preview" (build). 5173 (dev) usa el proxy de Vite.
CORS_ALLOWED_ORIGINS=https://sistemadetutoriasfront.onrender.com,http://localhost:4173,http://localhost:5173

# SOLO PRUEBAS: habilita POST /auth/dev (login por correo sin contraseña).
# Nunca en un despliegue publico.
AUTH_DEV_HABILITADO=false
