API_KEY=your-jwt-signing-secret-min-32-chars
API_JWT_EXPIRATION=36000000

DB_URL=jdbc:postgresql://localhost:5432/tutorias
DB_USERNAME=postgres
DB_PASSWORD=postgres

MAIL_HOST=smtp.gmail.com
# Puerto 587 => MAIL_SSL=false, MAIL_STARTTLS=true
# Puerto 465 => MAIL_SSL=true,  MAIL_STARTTLS=false (usar si la plataforma bloquea 587)
MAIL_PORT=587
MAIL_SSL=false
MAIL_STARTTLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Origenes exactos permitidos, separados por coma (scheme://host:puerto, sin
# barra final). Requerido con allowCredentials=true (no se admite "*").
# Ej. produccion: "https://mi-app.onrender.com". Dev: localhost del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
