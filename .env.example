API_KEY=your-jwt-signing-secret-min-32-chars
API_JWT_EXPIRATION=36000000

DB_URL=jdbc:postgresql://localhost:5432/tutorias
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Resend (https://resend.com) - API HTTP de correo. Reemplaza al SMTP de Gmail
# porque plataformas como Render bloquean puertos SMTP salientes (587/465).
# 1. Crea cuenta en resend.com (gratis: 3000 correos/mes, 100/dia)
# 2. Genera una API key en https://resend.com/api-keys
# 3. Para pruebas usa onboarding@resend.dev como FROM (solo envia al correo
#    registrado en tu cuenta de Resend). Para produccion verifica un dominio
#    en https://resend.com/domains y usa noreply@tu-dominio.com
RESEND_API_KEY=re_your_api_key
RESEND_FROM=onboarding@resend.dev

# Origenes exactos permitidos, separados por coma (scheme://host:puerto, sin
# barra final). Requerido con allowCredentials=true (no se admite "*").
# Ej. produccion: "https://mi-app.onrender.com". Dev: localhost del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
