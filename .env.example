API_KEY=your-jwt-signing-secret-min-32-chars
API_JWT_EXPIRATION=36000000

DB_URL=jdbc:postgresql://localhost:5432/tutorias
DB_USERNAME=postgres
DB_PASSWORD=postgres

# SendGrid (https://sendgrid.com) - API HTTP de correo. Reemplaza al SMTP de
# Gmail porque plataformas como Render bloquean puertos SMTP salientes.
# 1. Crea cuenta en sendgrid.com (free tier: 100 correos/dia)
# 2. Genera una API key en Settings > API Keys (permiso "Mail Send")
# 3. Verifica el remitente en Settings > Sender Authentication (Single Sender
#    Verification para pruebas, Domain Authentication para produccion). El
#    valor de SENDGRID_FROM debe coincidir con un remitente verificado.
SENDGRID_API_KEY=SG.your_api_key
SENDGRID_FROM=noreply@tu-dominio.com

# Origenes exactos permitidos, separados por coma (scheme://host:puerto, sin
# barra final). Requerido con allowCredentials=true (no se admite "*").
# Ej. produccion: "https://mi-app.onrender.com". Dev: localhost del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
